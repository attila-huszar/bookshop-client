{
  "name": "bookshop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun run --cwd ../bookshop-server dev",
    "setup": "bun run --cwd ../bookshop-server setup",
    "dev:client": "vite --host localhost --strictPort",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "test": "vitest --reporter=default",
    "test:cov": "vitest --coverage",
    "test:ui": "vitest --ui --coverage",
    "test:ci": "vitest run"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.14.0",
    "@stripe/react-stripe-js": "^7.0.1",
    "@stripe/stripe-js": "^10.3.0",
    "formik": "^2.4.9",
    "i18next": "^27.1.1",
    "i18next-http-backend": "^4.0.10",
    "ky": "^2.2.0",
    "lottie-react": "^3.1.2",
    "rc-slider": "^11.1.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-error-boundary": "^6.1.6",
    "react-hot-toast": "^2.6.1",
    "react-i18next": "^18.0.1",
    "react-redux": "^9.3.1",
    "react-router": "^8.5.1",
    "styled-components": "^6.6.0",
    "swiper": "^14.4.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.3.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-istanbul": "^5.1.0",
    "@vitest/eslint-plugin": "^1.6.28",
    "@vitest/ui": "^5.1.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-testing-library": "^7.16.2",
    "globals": "^17.14.0",
    "jiti": "^2.7.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.1.0"
  }
}
